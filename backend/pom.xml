<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM：统一依赖版本（Spring Boot BOM）与插件配置 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.campusoverflow</groupId>
    <artifactId>campus-overflow</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>CampusOverflow :: Parent</name>
    <description>大学校园版 Stack Overflow —— 模块化单体（DDD 限界上下文 + 六边形分层）</description>

    <modules>
        <module>co-shared-kernel</module>
        <module>co-identity</module>
        <module>co-qa</module>
        <module>co-reputation</module>
        <module>co-discovery</module>
        <module>co-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>2.8.6</springdoc.version>
        <archunit.version>1.3.0</archunit.version>
        <commonmark.version>0.24.0</commonmark.version>
        <owasp-sanitizer.version>20240325.1</owasp-sanitizer.version>
        <jacoco.version>0.8.12</jacoco.version>
        <!-- SonarQube 扫描插件（Lab 7 Step 3） -->
        <sonar-maven-plugin.version>4.0.0.4121</sonar-maven-plugin.version>
        <!-- SonarQube 扫描口径：多模块下 sonar-project.properties 不会被子模块读取，
             必须写在父 POM 的 properties 里由各模块继承 -->
        <sonar.projectKey>campus-overflow</sonar.projectKey>
        <sonar.projectName>CampusOverflow</sonar.projectName>
        <sonar.projectVersion>1.0.0</sonar.projectVersion>
        <!-- 各模块自己的 jacoco.xml，路径相对模块 basedir -->
        <sonar.coverage.jacoco.xmlReportPaths>co-bootstrap/target/site/jacoco/jacoco.xml,co-discovery/co-discovery-application/target/site/jacoco/jacoco.xml,co-discovery/co-discovery-domain/target/site/jacoco/jacoco.xml,co-identity/co-identity-application/target/site/jacoco/jacoco.xml,co-identity/co-identity-domain/target/site/jacoco/jacoco.xml,co-qa/co-qa-api/target/site/jacoco/jacoco.xml,co-qa/co-qa-application/target/site/jacoco/jacoco.xml,co-qa/co-qa-domain/target/site/jacoco/jacoco.xml,co-reputation/co-reputation-application/target/site/jacoco/jacoco.xml,co-reputation/co-reputation-domain/target/site/jacoco/jacoco.xml,co-shared-kernel/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.coverage.exclusions>**/co-bootstrap/**,**/infrastructure/**,**/interfaces/**,**/*Application.java,**/*Config.java,**/dto/**,**/api/**/*Event.java</sonar.coverage.exclusions>
        <sonar.sourceEncoding>UTF-8</sonar.sourceEncoding>
        <sonar.scm.provider>git</sonar.scm.provider>
        <!-- 覆盖 Spring Boot 3.4.5 BOM 的 testcontainers 1.20.x：其内置 docker-java 默认 Docker API 1.32，
             GitHub runner 的 daemon 要求 ≥1.40（否则 "Could not find a valid Docker environment"）；
             1.21.x 的 docker-java 默认 API 已升级，CampusOverflowFlowIT 才能在 CI 上运行（V3 §8.3） -->
        <testcontainers.version>1.21.3</testcontainers.version>
        <!-- 领域层行覆盖率门禁（适应度函数 FF-4）。Sprint 1 起 0.70（T1-14）；Sprint 4 挑战 0.80 -->
        <domain.coverage.minimum>0.70</domain.coverage.minimum>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-identity-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-identity-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-identity-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-identity-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-identity-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-qa-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-qa-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-qa-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-qa-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-qa-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-reputation-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-reputation-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-reputation-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-reputation-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-reputation-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-discovery-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-discovery-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-discovery-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-discovery-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-discovery-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-shared-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark-ext-gfm-tables</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
            <dependency>
                <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
                <artifactId>owasp-java-html-sanitizer</artifactId>
                <version>${owasp-sanitizer.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
